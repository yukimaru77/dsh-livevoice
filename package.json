{
  "name": "dsh-livevoice",
  "version": "0.1.6",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Codex realtime live voice for DeepSeek Harness: WebRTC + Frameless Bidi + session delegation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aa2246740/dsh-livevoice.git"
  },
  "homepage": "https://github.com/aa2246740/dsh-livevoice#readme",
  "bugs": {
    "url": "https://github.com/aa2246740/dsh-livevoice/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "livevoice",
    "webrtc"
  ],
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.1 <0.2.2"
  },
  "main": "lib/dsh-livevoice.js",
  "files": [
    "lib/*.js",
    "lib/*.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/dsh-livevoice.d.ts",
      "import": "./lib/dsh-livevoice.js",
      "default": "./lib/dsh-livevoice.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "import": "./lib/client.js",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "entry": "./lib/client.js",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm test && pnpm build"
  },
  "dependencies": {
    "https-proxy-agent": "^7.0.6",
    "undici": "^7.16.0",
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.1 <0.2.2",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-rc.1 <0.2.2",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.2.1-rc.1 <0.2.2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-rc.1 <0.2.2",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-rc.1 <0.2.2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.1 <0.2.2",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.1-rc.1 <0.2.2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-rc.1 <0.2.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.1 <0.2.2",
    "@deepseek-ai/dsh-commands": ">=0.2.1-rc.1 <0.2.2",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.1 <0.2.2",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.1-rc.1 <0.2.2",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.1 <0.2.2",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.1 <0.2.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/ws": "^8.18.1",
    "lightningcss": "^1.33.0",
    "react": "^18.2.0",
    "semver": "7.7.2",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
